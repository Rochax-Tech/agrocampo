rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de produtos, banners/logos e equipe da VetClínica: públicas para
    // leitura (o site precisa exibi-las sem login), escrita só do admin
    // autenticado, com limite de tamanho e tipo pra evitar abuso.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
