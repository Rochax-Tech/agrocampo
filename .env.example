# Config pública do Firebase Web (o próprio Firebase permite expor no cliente —
# a proteção real vem das Firestore/Storage Security Rules, não de esconder isso).
# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# em: Firebase Console > Configurações do projeto > Seus apps > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Futuro: chaves privadas de gateway de pagamento NUNCA entram aqui com prefixo
# VITE_ (tudo que começa com VITE_ é embutido no bundle e vai pro navegador).
# Segredos de servidor vão em functions/.env, carregado só pelo backend
# (Firebase Cloud Functions), nunca pelo frontend.
